# ============================================================
# YoudaoNoteLM 环境变量配置
# 复制此文件为 .env 并修改对应的值
# cp .env.example .env
# ============================================================

# ============================================================
# Docker 容器环境变量
# ============================================================

# 镜像配置（默认从 Docker Hub 拉取；本地构建时注释掉即可）
DOCKER_IMAGE=flandern/youdaonote:latest
MARKITDOWN_IMAGE=flandern/markitdown:latest

# 应用端口（服务器部署建议改为 18080 避免冲突）
APP_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=youdao

# Redis
REDIS_PASSWORD=your_redis_password

# MinIO 对象存储
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Milvus 向量数据库（内部服务发现端口由 docker_config.yaml 管理，无需在此配置）
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin

# ============================================================
# 应用配置变量（覆盖 docker_config.yaml 中的空字段）
# 缺少以下变量会导致启动失败或功能不可用
# ============================================================

# MySQL 连接密码（通常与 MYSQL_ROOT_PASSWORD 一致）
MYSQL_PASSWORD=your_mysql_root_password

# JWT 签名密钥（必填）
JWT_SECRET=your_jwt_secret_key

# 邮箱 SMTP 密码（必填）
EMAIL_PASSWORD=your_email_password

# API Key 加密密钥（必填，必须恰好 32 字节）
ENCRYPTION_KEY=your_32_byte_encryption_key

# MinIO 访问密钥（通常与 MINIO_ROOT_USER/PASSWORD 一致）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_password

# MinIO 内部 endpoint（SDK 连接用，容器内可达地址）
# 本地开发可设为 localhost:9000；Docker 部署设为 minio:9000
MINIO_ENDPOINT=minio:9000

# MinIO 公网 endpoint（仅用于预签名 URL 的 host 重写，SDK 不连接此地址）
# 浏览器/外部服务（如阿里云 ASR）通过此地址访问 MinIO
MINIO_PUBLIC_ENDPOINT=your-domain.com:18080

# 博查搜索 API Key（留空则禁用联网搜索）
BOCHA_API_KEY=

# Notion OAuth（四项任一缺失时 Notion 功能不可用；请仅填入部署 Secret）
# 本地源码开发回调：http://localhost:8081/api/v1/notion/oauth/callback；完整 Docker Compose 请改为 http://localhost:8080/api/v1/notion/oauth/callback（或生产公网地址）
# Notion 应用需启用 Read content，并将登记的 OAuth Redirect URI 与 NOTION_REDIRECT_URI 完全一致；Go 直接调用 Notion HTTP API，Compose 不新增服务
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
# 必须与 Notion 应用登记的后端回调地址完全一致
NOTION_REDIRECT_URI=http://localhost:8081/api/v1/notion/oauth/callback
# OAuth 完成后后端跳转到此前端地址
NOTION_FRONTEND_REDIRECT_URL=http://localhost:5173/settings
